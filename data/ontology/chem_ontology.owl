  </rdf:type>
  <meta:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'Surface Tension of N‑Methyldiethanolamine in Methanol or in\nMethanol Aqueous Solutions as a Solvent at Temperatures from\n293.15 to 323.15 K\n'</meta:source>
  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Experimental data were correlated with temperature and concentration by means of the Jasper equation.</meta:content>
