  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The constant n is the electron transfer number, which for methylene blue is 2.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
