  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WP6 is the host molecule that interacts with caffeine, theophylline, and theobromine, forming host-guest complexes and causing changes in their NMR and fluorescence spectra.</meta:content>
