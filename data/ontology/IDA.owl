  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recognition motifs play an essential role in sensor fabrication using the indicator displacement assay design strategy.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
