  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The results obtained from ground-state absorption, SS fluorescence, TR-fluorescence and NMR studies clearly indicate that the protonated form (AcH + ) of acridine dye undergoes very strong inclusion complex formation with SCX4 host.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

