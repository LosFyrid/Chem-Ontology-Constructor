  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Superclass: ditopic_guest): The n-phenyl-2-naphthylammonium cation is described as a ditopic guest, so it is a subclass of ditopic_guest.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hierarchy</meta:type>
</owl:NamedIndividual>

