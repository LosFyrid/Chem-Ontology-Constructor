  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-canonically folded DNA is a form of DNA structure that deviates from the standard double helix and is the subject of base modification sensing with an optimized host:guest sensing array.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

