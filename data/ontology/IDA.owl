  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence intensity is a measurable property that is enhanced or attenuated in response to molecular interactions in the F-IDA systems.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

