  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biorelevant targets are molecules or structures of biological significance that can be selectively recognized by cavitands.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

