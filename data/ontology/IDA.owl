  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence decays of both AcH + and Ac are measured to understand their behavior in the absence and presence of SCX4.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2387">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
