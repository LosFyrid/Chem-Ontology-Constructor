  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiple different water-soluble deep cavitands can perform selective cavity-based molecular recognition in cells.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

