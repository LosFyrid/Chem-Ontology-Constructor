  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The GO on the electrode surface was reduced by performing CV between 0.3 V and 1.3 V at a scan rate of 0.025 V/s for 10 cycles in a deoxygenated 0.1 M PBS.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

