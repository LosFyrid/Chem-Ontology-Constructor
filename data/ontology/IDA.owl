  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">upfield shift observed for H9 and H10 protons upon complexation with Q(8)</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data_property</meta:type>
  <meta:property rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nmr_upfield_shift</meta:property>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1583">
