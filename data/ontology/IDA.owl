  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CB(7) is one of the most effective macrocyclic hosts known, but its target affinity is weakened by high concentrations of sodium salts.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

