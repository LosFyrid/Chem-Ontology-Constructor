  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Selective molecular recognition is a process by which hosts such as cavitands can bind specific biorelevant targets.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

