  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">THC is a chemical compound selectively sensed in biofluids by host:guest arrays.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
