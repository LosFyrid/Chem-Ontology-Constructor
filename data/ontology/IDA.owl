  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Significant microenvironment sensitive changes in the spectroscopic properties of acridine dyes make them useful fluorescence probes to study local environments of various constrained systems like micelles, reverse micelles, macrocyclic nanocavities, etc.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1876">
