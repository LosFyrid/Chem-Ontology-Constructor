  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1 H NMR spectroscopy was first performed to study the host-guest complexation between WP6 and ST.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
