  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fig. S5A showed a well-defined reversible redox pair of (Fe(CN)6)(3-) GLYPH&lt;0&gt; /4 GLYPH&lt;0&gt; at the bare GC electrode.</meta:content>
