  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CB7 is used in combination with various fluorophores for the detection of pharmaceuticals through fluorescence indicator displacement assays.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
