  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acridine dye is a chemical compound whose protonated and neutral forms were studied using absorption and steady-state fluorescence measurements.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1945">
