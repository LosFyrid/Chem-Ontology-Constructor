  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Superclass: host-guest_system): A host-guest inclusion complex is a specific type of host-guest system, where the guest is encapsulated by the host.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hierarchy</meta:type>
</owl:NamedIndividual>

