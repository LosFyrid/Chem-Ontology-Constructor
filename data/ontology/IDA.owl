  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Superclass: AcH+_SCX4): AcH+_SCX4_AcCh is a ternary system involving AcH+, SCX4, and AcCh, and is a more specific system than AcH+_SCX4.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hierarchy</meta:type>
</owl:NamedIndividual>

