  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcH+ is used at a concentration of 1.37 mM in the study as part of the AcH+ -SCX4-AcCh system.</meta:content>
