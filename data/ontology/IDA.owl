  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular sensing is the process in which F-IDAs, using CB n as recognition units, detect specific molecules.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

