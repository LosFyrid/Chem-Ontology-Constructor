  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The obtained electrode was denoted as pNAANI/rGO/GC and carefully rinsed with ultrapure water.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation356">
