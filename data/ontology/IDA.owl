  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Looking up the Critical Values of the t Distribution (t0.01/2 = 9.925, two-tails), the outcome of this statistical comparison substantiated that there are no significant discrepancies.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation902">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
