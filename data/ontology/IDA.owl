  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dye is a chemical compound that can undergo fluorescence and is subject to quenching processes in the presence of a host molecule such as SCX4.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2570">
