  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Methylene blue (MB) is used as a probe in the host-guest recognition scheme for quinine detection.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
