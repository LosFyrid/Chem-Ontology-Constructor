  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stimulus responsive dye displacement is a process investigated as part of the proposed mechanism for dye-host interactions.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2769">
