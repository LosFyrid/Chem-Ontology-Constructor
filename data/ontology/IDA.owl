  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cyclodextrins have hydrophilic exterior cavities that contribute to their selective binding properties.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
