  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ability of TCC to form strong complexes with dyes such as DSMI is known ( K d = 5.2 μ M in buffer), and the affinity of DTMI for TCC ( K d = 8.9 μ M in buffer) is quite similar to that of DSMI.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation3577">
