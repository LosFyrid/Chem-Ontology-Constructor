  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Superclass: quenching_mechanism): ET (electron transfer) interaction is a possible quenching mechanism.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hierarchy</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2590">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
