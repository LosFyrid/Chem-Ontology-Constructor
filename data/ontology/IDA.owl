  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence peak position refers to the wavelength at which the maximum emission occurs in the fluorescence spectra, which remains unchanged upon SCX4 addition.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
