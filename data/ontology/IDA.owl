  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Superclass: acridine_dye): AcH_+ is the protonated form of acridine_dye, making it a subclass of acridine_dye.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hierarchy</meta:type>
</owl:NamedIndividual>

