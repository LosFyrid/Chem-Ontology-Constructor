  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">union(drug_delivery, drug_formulation, food_industry, pharmaceuticals, nanomedicine, photodynamic_therapy, photostabilization, catalysis, nanotechnology, functional_material, optical_sensor, on_off_switch)</meta:content>
