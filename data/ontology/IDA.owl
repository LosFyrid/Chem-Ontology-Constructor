  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structurally the SCXn homologues possess p-hydroxybenzenesulfonate monomer units joined via methylene linkages resulting in the macrocyclic constitution of these host molecules.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1782">
