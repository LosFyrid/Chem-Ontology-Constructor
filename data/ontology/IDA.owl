  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cavitand is a host molecule added to cells after dye incubation to study its effects on dye localization and binding.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation3600">
