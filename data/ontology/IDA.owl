  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strong supramolecular complex was formed as indicated by changes in fluorescence and emission spectra.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation4768">
