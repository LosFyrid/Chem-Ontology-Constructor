  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time-resolved fluorescence measurements are a very sensitive technique in understanding the changes in the microenvironments for the fluorophore.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2380">
