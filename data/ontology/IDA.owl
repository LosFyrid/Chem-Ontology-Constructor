  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The response of the present supramolecular fluorescence sensor system largely depends upon the prototropic nature of the indicator dye acridine and the binding strengths of the two prototropic forms of the dye with the macrocyclic SCX4 host.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

