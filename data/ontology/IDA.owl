  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Calixarenes are a class of macrocyclic compounds with biomedical applications, as reviewed in the state of the art and perspectives.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

