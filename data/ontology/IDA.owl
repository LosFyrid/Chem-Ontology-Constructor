  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence_titration data were used to support the 1:1 stoichiometry of the host-guest complexes formed in the present systems.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

