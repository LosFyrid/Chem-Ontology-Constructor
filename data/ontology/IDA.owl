  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A supramolecular system was developed, composed of the electron-deficient dye ST and the anionic water-soluble pillar6 arene WP6.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
