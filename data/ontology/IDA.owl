  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Superclass: lipid_bilayer): POPC_vesicle is a type of lipid_bilayer, as the text states that TCC binds in synthetic lipid bilayers such as POPC vesicles.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hierarchy</meta:type>
</owl:NamedIndividual>

