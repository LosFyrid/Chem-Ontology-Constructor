  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Job's plot studies unambiguously indicate the formation of 1:1 stoichiometric complexes in the present systems.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

