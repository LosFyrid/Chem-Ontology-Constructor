  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ac is one of the prototropic forms of the dye involved in the equilibrium with AcH+ in the presence of SCX4.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2323">
