  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The indicator displacement process was used to measure the nonfluorescent host-indicator complex to detect caffeine.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation4925">
