  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chemical system refers to the set of chemical species and their interactions under specific experimental conditions, such as the SCX4system studied at various pH values and in the presence of AcH.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

