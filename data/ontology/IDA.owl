  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The TCC·DSMI complex is a host-guest complex located in the outer membrane and is involved in the indicator displacement assay.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
