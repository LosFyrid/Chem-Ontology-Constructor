  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anionic TCC and cationic CHI CHP show a kinetically stable folded 'vase' conformation in water and bind styrylpyridinium dyes strongly.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation3515">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
