  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KCl refers to potassium chloride, used as the supporting electrolyte at 0.1 M concentration in the EIS and CV experiments.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

