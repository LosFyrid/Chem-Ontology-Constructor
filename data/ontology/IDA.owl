        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="http://www.test.org/chem_ontologies/classes/twisted_intramolecular_charge_transfer_state"/>
    </owl:Restriction>
  </rdf:type>
