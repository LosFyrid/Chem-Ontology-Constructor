  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fluorescent indicator is first bound to a receptor and then displaced by a competing analyte in fluorescent indicator displacement assays.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

