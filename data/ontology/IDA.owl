  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The rGO/GC electrode was then scanned from 0.2 V to 0.9 V at a scan rate of 0.1 V/s for 30 cycles in a 0.1 M N-acetylaniline solution containing 1.0 M HClO4.</meta:content>
