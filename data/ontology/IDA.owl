  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The corrected fluorescence intensity recovery for the AcH+-SCX4-AcCh complex is estimated as about 88%.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
