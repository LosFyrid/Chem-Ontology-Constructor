  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Beta-cyclodextrin (β-CD) was selected as the recognition motif and receptor, facilitating host-guest recognition in the sensor.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

