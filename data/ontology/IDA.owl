  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Superclass: enzyme): Amino acid decarboxylase is an enzyme that catalyzes the decarboxylation of amino acids.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hierarchy</meta:type>
</owl:NamedIndividual>

