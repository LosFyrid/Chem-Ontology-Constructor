  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Several characteristic GO bands were observed, including those at 3371 cm GLYPH&lt;0&gt; 1, 1729 cm GLYPH&lt;0&gt; 1, 1622 cm GLYPH&lt;0&gt; 1, and 1080 cm GLYPH&lt;0&gt; 1, which represent the stretching vibrations of -OH, C --O, C --C, and C -O bonds, respectively.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

