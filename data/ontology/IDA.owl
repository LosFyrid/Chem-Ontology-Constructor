<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1679">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="http://www.test.org/chem_ontologies/meta/has_information"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="http://www.test.org/chem_ontologies/classes/acridine_dye(Ac)"/>
    </owl:Restriction>
  </rdf:type>
  <data:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1002/slct.201600226</data:source>
  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acridine dye is a biologically important dye that exists in both protonated and neutral forms and is studied for its binding interactions with p-sulfonatocalix(4)arene.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1680">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="http://www.test.org/chem_ontologies/meta/has_information"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="http://www.test.org/chem_ontologies/classes/protonated_acridine_dye(AcH+)"/>
    </owl:Restriction>
  </rdf:type>
  <data:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1002/slct.201600226</data:source>
  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The protonated form of acridine dye, denoted as AcH+, undergoes strong binding with p-sulfonatocalix(4)arene and exhibits a large upward pKa shift when bound.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1681">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="http://www.test.org/chem_ontologies/meta/has_information"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="http://www.test.org/chem_ontologies/classes/p-sulfonatocalix(4)arene(SCX4)"/>
    </owl:Restriction>
  </rdf:type>
  <data:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1002/slct.201600226</data:source>
  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P-sulfonatocalix(4)arene (SCX4) is a host molecule that forms complexes with both protonated and neutral forms of acridine dye, affecting their photochemical properties.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

