  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">These changes may arise from the formation of twisted intramolecular charge transfer (TICT) state when ST occupied the WP6 cavity in the aqueous buffer.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation4769">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
