  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Probe refers to the molecule, such as methylene blue, used to facilitate the detection of quinine via host-guest recognition.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
