  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F-IDAs of CB7 with three fluorophores, palmatine, berberine, and coptisine, were reported for the detection of both labetalol hydrochloride and dibucaine.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

