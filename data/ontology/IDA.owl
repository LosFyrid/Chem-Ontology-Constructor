  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The electrochemical sensor is a device used for the selective detection of quinine in the presence of other molecules.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
