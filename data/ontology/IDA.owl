  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An inclusion complex is formed when quinine or methylene blue enters the beta-cyclodextrin cavity.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

