  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The electropolymerization of N-acetylaniline was performed following the preparation of the rGO/GC electrode.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation554">
