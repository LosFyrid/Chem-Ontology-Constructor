  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organophosphate esters are compounds used to assess enzyme suppression in the proposed fluorescence displacement system.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

