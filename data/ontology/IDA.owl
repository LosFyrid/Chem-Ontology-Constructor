  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exchange kinetics of deep cavitands are controlled by the lipid bilayer environment.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
