  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Macrocycles are more rigid molecular structures compared to water-soluble, self-folding deep cavitands.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation3330">
