  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An analyte is a target molecule that competes with an indicator molecule for the shared binding site on the host in the indicator displacement assay.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
