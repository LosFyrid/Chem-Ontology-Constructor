  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dye-host interaction refers to the mechanism proposed for the interaction between dye molecules and host molecules such as SCX4.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2768">
