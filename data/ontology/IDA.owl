  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The rGO/GC electrode was initially subjected to chronoamperometry at a constant voltage of 1.0 V for 90 s.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation352">
