  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Luteolin is a signal guest that forms a complex with CB7, leading to intensified fluorescence.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

