  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2PF@Q[8] (written as 2pf@q(8) to comply with naming conventions) is the newly developed fluorescent indicator suitable for practical GEF detection.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation1521">
  <rdf:type rdf:resource="http://www.test.org/chem_ontologies/meta/SourcedInformation"/>
