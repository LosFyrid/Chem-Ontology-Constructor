  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcCh is used as a suitable external stimulus for fine tuning the supramolecularly assisted pKa shift of the dye.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation2325">
