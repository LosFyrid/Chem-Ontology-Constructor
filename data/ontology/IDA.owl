    </owl:Restriction>
  </rdf:type>
  <data:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.1021/acssensors.3c00886</data:source>
  <meta:file_path rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></meta:file_path>
  <meta:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Despite the large nucleotide concentration in the cell, the cavitand is able to retain the dye in its cavity and sequester the TCC DSMI · complex in the membrane.</meta:content>
  <meta:type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entity</meta:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.test.org/chem_ontologies/meta/sourcedinformation3578">
